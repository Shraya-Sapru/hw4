# Copy this file to .env (in this same folder) and fill in real values.
# Never commit the real .env — it's listed in .gitignore.

# Portkey API key used to route chatbot model calls to OpenAI.
# Get this from your Portkey account (https://portkey.ai).
PORTKEY_API_KEY=your-portkey-api-key-here

# Secret key used to sign login session tokens (JWTs). Use a long, random
# string — e.g. generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=your-random-session-secret-here
